#!/bin/bash
# ==============================================================================
# Kubernetes Cluster Post-Provisioning Setup & Troubleshooting Script
# ==============================================================================
# Run this on the MASTER node AFTER:
# 1. Terraform creates EC2 instances
# 2. You manually join worker node using kubeadm join command
#
# Usage: bash k8s-cluster-setup.sh
# ==============================================================================

set -e  # Exit on error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
KUBECONFIG_DIR="$HOME/.kube"
KUBECONFIG_FILE="$KUBECONFIG_DIR/config"
ADMIN_CONF="/etc/kubernetes/admin.conf"
MAX_WAIT_SECONDS=300
CHECK_INTERVAL=10

# ==============================================================================
# Helper Functions
# ==============================================================================

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[✓]${NC} $1"; }
log_warn()    { echo -e "${YELLOW}[!]${NC} $1"; }
log_error()   { echo -e "${RED}[✗]${NC} $1"; }

check_command() {
    if ! command -v "$1" &> /dev/null; then
        log_error "$1 is not installed. Please install it first."
        exit 1
    fi
}

wait_for_condition() {
    local description="$1"
    local condition_cmd="$2"
    local elapsed=0
    
    log_info "Waiting for: $description"
    
    while [ $elapsed -lt $MAX_WAIT_SECONDS ]; do
        if eval "$condition_cmd" &> /dev/null; then
            log_success "$description - Ready!"
            return 0
        fi
        sleep $CHECK_INTERVAL
        elapsed=$((elapsed + CHECK_INTERVAL))
        echo -n "."
    done
    
    echo ""
    log_error "Timeout: $description not ready after ${MAX_WAIT_SECONDS}s"
    return 1
}

# ==============================================================================
# Main Setup Functions
# ==============================================================================

fix_kubeconfig() {
    log_info "Step 1: Fixing kubeconfig permissions..."
    
    # Create .kube directory if missing
    if [ ! -d "$KUBECONFIG_DIR" ]; then
        mkdir -p "$KUBECONFIG_DIR"
        log_info "Created $KUBECONFIG_DIR"
    fi
    
    # Copy admin.conf if config doesn't exist or is empty
    if [ ! -f "$KUBECONFIG_FILE" ] || [ ! -s "$KUBECONFIG_FILE" ]; then
        if [ -f "$ADMIN_CONF" ]; then
            sudo cp -i "$ADMIN_CONF" "$KUBECONFIG_FILE"
            sudo chown "$(id -u):$(id -g)" "$KUBECONFIG_FILE"
            chmod 600 "$KUBECONFIG_FILE"
            log_success "Kubeconfig copied and permissions set"
        else
            log_error "Admin config not found at $ADMIN_CONF"
            log_warn "kubeadm init may not have completed. Check: sudo journalctl -u kubelet"
            return 1
        fi
    else
        # Ensure permissions are correct even if file exists
        sudo chown "$(id -u):$(id -g)" "$KUBECONFIG_FILE" 2>/dev/null || true
        chmod 600 "$KUBECONFIG_FILE"
        log_success "Kubeconfig permissions verified"
    fi
    
    # Unset any bad KUBECONFIG env var and ensure correct one
    unset KUBECONFIG
    export KUBECONFIG="$KUBECONFIG_FILE"
    
    # Make it persistent for future sessions
    if ! grep -q "export KUBECONFIG=" "$HOME/.bashrc" 2>/dev/null; then
        echo "export KUBECONFIG=\$HOME/.kube/config" >> "$HOME/.bashrc"
        log_info "Added KUBECONFIG to ~/.bashrc for persistence"
    fi
    
    return 0
}

verify_cluster_access() {
    log_info "Step 2: Verifying cluster API access..."
    
    # Test kubectl with explicit config
    if kubectl cluster-info &> /dev/null; then
        log_success "kubectl can reach API server"
        kubectl cluster-info | head -2
        return 0
    else
        log_error "kubectl cannot reach API server"
        
        # Diagnostic info
        log_warn "Checking kubelet status..."
        sudo systemctl is-active kubelet || log_error "kubelet is not running!"
        
        log_warn "Checking API server container..."
        sudo crictl ps 2>/dev/null | grep kube-apiserver || \
        sudo docker ps 2>/dev/null | grep kube-apiserver || \
        log_warn "API server container not found"
        
        return 1
    fi
}

wait_for_nodes() {
    log_info "Step 3: Waiting for nodes to be Ready..."
    
    # Wait for at least the master node to be Ready
    wait_for_condition "Master node Ready" \
        "kubectl get nodes --no-headers | grep -E 'control-plane|master' | grep -q 'Ready'"
    
    # Show node status
    log_info "Current node status:"
    kubectl get nodes -o wide
    
    # Check if worker is also ready (optional, give it more time)
    local worker_count=$(kubectl get nodes --no-headers | grep -v "control-plane\|master" | wc -l)
    if [ "$worker_count" -gt 0 ]; then
        log_info "Found $worker_count worker node(s). Waiting for them to be Ready..."
        wait_for_condition "All nodes Ready" \
            "kubectl get nodes --no-headers | grep -v 'Ready' | grep -v 'control-plane\|master' | wc -l | grep -q '^0$'" || \
            log_warn "Some worker nodes still not Ready (this may take a few more minutes)"
    fi
    
    return 0
}

verify_system_pods() {
    log_info "Step 4: Verifying critical system pods..."
    
    local namespaces=("kube-system" "calico-system" "tigera-operator")
    local all_ready=true
    
    for ns in "${namespaces[@]}"; do
        if kubectl get namespace "$ns" &> /dev/null; then
            log_info "Checking pods in namespace: $ns"
            
            # Get pods that are NOT Running or Completed
            local failing_pods=$(kubectl get pods -n "$ns" --no-headers 2>/dev/null | \
                grep -v -E 'Running|Completed' | wc -l)
            
            if [ "$failing_pods" -eq 0 ]; then
                local pod_count=$(kubectl get pods -n "$ns" --no-headers 2>/dev/null | wc -l)
                log_success "All $pod_count pods in $ns are healthy"
            else
                log_warn "Found $failing_pods pod(s) with issues in $ns"
                kubectl get pods -n "$ns" --no-headers | grep -v -E 'Running|Completed' || true
                all_ready=false
            fi
        fi
    done
    
    if [ "$all_ready" = true ]; then
        log_success "All system pods are healthy!"
    else
        log_warn "Some pods still initializing. Check with: kubectl get pods -A"
    fi
    
    return 0
}

generate_join_command() {
    log_info "Step 5: Generate worker join command (if needed)..."
    
    if [ -f "$ADMIN_CONF" ]; then
        echo ""
        echo -e "${YELLOW}=== Worker Node Join Command ===${NC}"
        echo "# Run this on your WORKER node to join the cluster:"
        echo ""
        sudo kubeadm token create --print-join-command 2>/dev/null || \
            echo "# Token creation failed - cluster may already have tokens"
        echo ""
        echo -e "${YELLOW}=================================${NC}"
        echo ""
    fi
}

show_cluster_summary() {
    log_info "Step 6: Cluster Summary"
    echo ""
    echo -e "${GREEN}=== Kubernetes Cluster Status ===${NC}"
    echo ""
    
    # Nodes
    echo "📦 Nodes:"
    kubectl get nodes -o wide
    echo ""
    
    # Core components
    echo "🔧 Core Components (kube-system):"
    kubectl get pods -n kube-system -o wide | head -10
    echo ""
    
    # CNI
    if kubectl get namespace calico-system &> /dev/null; then
        echo "🌐 CNI (calico-system):"
        kubectl get pods -n calico-system -o wide
        echo ""
    fi
    
    # Quick resource check
    echo "📊 Quick Resource Check:"
    echo "  Deployments: $(kubectl get deployments -A --no-headers 2>/dev/null | wc -l)"
    echo "  Services:    $(kubectl get services -A --no-headers 2>/dev/null | wc -l)"
    echo "  Pods:        $(kubectl get pods -A --no-headers 2>/dev/null | wc -l)"
    echo ""
    
    echo -e "${GREEN}=================================${NC}"
}

troubleshoot_common_issues() {
    log_info "Step 7: Quick Troubleshooting Checks..."
    
    # Check if swap is disabled
    if swapon --show | grep -q .; then
        log_warn "Swap is enabled! This can cause kubelet issues."
        log_info "To disable: sudo swapoff -a && sudo sed -i '/ swap / s/^/#/' /etc/fstab"
    else
        log_success "Swap is disabled ✓"
    fi
    
    # Check container runtime
    if sudo systemctl is-active containerd &> /dev/null; then
        log_success "Containerd is running ✓"
    else
        log_warn "Containerd may not be running. Check: sudo systemctl status containerd"
    fi
    
    # Check kubelet
    if sudo systemctl is-active kubelet &> /dev/null; then
        log_success "Kubelet is active ✓"
    else
        log_error "Kubelet is not running! Check: sudo journalctl -u kubelet -n 20"
    fi
    
    # Check for common pod issues
    local pending_pods=$(kubectl get pods -A --field-selector=status.phase=Pending --no-headers 2>/dev/null | wc -l)
    if [ "$pending_pods" -gt 0 ]; then
        log_warn "Found $pending_pods pending pod(s). Check with: kubectl get pods -A --field-selector=status.phase=Pending"
    fi
    
    local crash_pods=$(kubectl get pods -A --field-selector=status.phase=Failed --no-headers 2>/dev/null | wc -l)
    if [ "$crash_pods" -gt 0 ]; then
        log_warn "Found $crash_pods failed pod(s). Check logs with: kubectl logs <pod-name> -n <namespace>"
    fi
}

show_next_steps() {
    echo ""
    echo -e "${GREEN}=== 🎉 Setup Complete! Next Steps ===${NC}"
    echo ""
    echo "1️⃣  Deploy a test application:"
    echo "   kubectl create deployment nginx --image=nginx:latest"
    echo "   kubectl expose deployment nginx --type=NodePort --port=80"
    echo "   kubectl get svc nginx  # Note the NODE-PORT"
    echo "   # Access: http://<WORKER-IP>:<NODE-PORT>"
    echo ""
    echo "2️⃣  Useful commands:"
    echo "   kubectl get pods -A              # All pods"
    echo "   kubectl describe node <name>     # Node details"
    echo "   kubectl logs -f <pod-name>       # Stream logs"
    echo "   kubectl exec -it <pod> -- bash   # Shell into pod"
    echo ""
    echo "3️⃣  Monitor resources:"
    echo "   kubectl top nodes                # Requires metrics-server"
    echo "   watch -n 2 'kubectl get pods -A' # Live view"
    echo ""
    echo "4️⃣  Cleanup when done:"
    echo "   cd terraform-k8s-practice"
    echo "   terraform destroy -auto-approve"
    echo ""
    echo -e "${YELLOW}💡 Tip: This script is idempotent - safe to re-run anytime!${NC}"
    echo ""
}

# ==============================================================================
# Main Execution
# ==============================================================================

main() {
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}  K8s Cluster Post-Provisioning Setup${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo ""
    
    # Pre-flight checks
    check_command kubectl
    check_command kubeadm
    
    # Run setup steps
    fix_kubeconfig || exit 1
    verify_cluster_access || exit 1
    wait_for_nodes
    verify_system_pods
    generate_join_command
    show_cluster_summary
    troubleshoot_common_issues
    show_next_steps
    
    log_success "All setup steps completed!"
    echo -e "${GREEN}Your cluster is ready for practice! 🚀${NC}"
}

# Run main function
main "$@"
